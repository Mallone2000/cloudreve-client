{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "add-drive",
  "description": "Authorization and folder selection window",
  "windows": ["add-drive"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    {"identifier": "opener:allow-open-url", "allow": [{"url": "https://*"}]},
    "dialog:allow-open",
    "allow-is-dir-empty",
    "allow-close-window",
    "allow-begin-oauth",
    "allow-finish-oauth",
    "allow-open-folder-and-close-window"
  ]
}
