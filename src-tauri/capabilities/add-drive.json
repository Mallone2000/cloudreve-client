{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "add-drive",
  "description": "Authorization and folder selection window",
  "windows": ["add-drive"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:default",
    "opener:default",
    "dialog:default",
    "allow-is-dir-empty",
    "allow-close-window",
    "allow-begin-oauth",
    "allow-finish-oauth",
    "allow-open-folder-and-close-window"
  ]
}
