{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Cloudreve desktop",
  "windows": ["main", "main_popup"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-close",
    "allow-get-status-summary",
    "allow-show-add-drive-window",
    "allow-show-settings-window",
    "allow-resolve-conflict",
    "allow-pause-sync",
    "allow-resume-sync",
    "allow-show-file-in-explorer"
  ]
}
