{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for Cloudreve desktop",
  "windows": ["main", "main_popup"],
  "permissions": [
    "core:default",
    "core:app:default",
    "core:window:default",
    "core:webview:default",
    "core:menu:default",
    "core:tray:default",
    "core:path:default",
    "core:event:default",
    "core:image:default",
    "opener:default",
    "dialog:default",
    "core:window:allow-close",
    "os:default",
    "notification:default",
    "autostart:default",
    "deep-link:default",
    "positioner:default",
    "updater:default",
    "process:allow-restart",
    "app:allow-get-status-summary",
    "app:allow-show-add-drive-window",
    "app:allow-show-settings-window",
    "app:allow-resolve-conflict",
    "app:allow-pause-sync",
    "app:allow-resume-sync",
    "app:allow-show-file-in-explorer"
  ]
}
