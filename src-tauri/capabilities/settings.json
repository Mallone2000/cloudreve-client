{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "settings",
  "description": "Drive and application settings window",
  "windows": ["settings"],
  "permissions": [
    "core:app:allow-version",
    {"identifier": "opener:allow-open-url", "allow": [{"url": "https://*"}]},
    "dialog:allow-ask",
    "allow-get-drives-info",
    "allow-get-user-profile",
    "allow-get-auto-start-enabled",
    "allow-get-general-settings",
    "allow-get-ignore-patterns",
    "allow-get-default-ignore-patterns",
    "allow-get-drive-max-file-size",
    "allow-show-add-drive-window",
    "allow-close-window",
    "allow-remove-drive",
    "allow-set-ignore-patterns",
    "allow-set-drive-max-file-size",
    "allow-show-file-in-explorer",
    "allow-show-reauthorize-window",
    "allow-set-auto-start",
    "allow-set-notify-credential-expired",
    "allow-set-notify-file-conflict",
    "allow-set-fast-popup-launch",
    "allow-set-heartbeat-interval",
    "allow-set-log-to-file",
    "allow-set-log-level",
    "allow-set-log-max-files",
    "allow-set-language",
    "allow-open-log-folder"
  ]
}
